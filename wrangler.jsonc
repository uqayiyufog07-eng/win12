{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "win12",
  "compatibility_date": "2026-07-19",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    // 纯静态站点：目录请求自动补 index.html，404 交给自定义页面
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
